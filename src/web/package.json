{
  "name": "hatshop-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTML-native HatShop storefront on Cloudflare Workers over the existing Neon PostgreSQL catalog/order engine.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "introspect": "node scripts/introspect.mjs",
    "verify:interactive": "node scripts/verify-interactive.mjs",
    "bench": "node --test tests/bench.cpu.test.ts"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "wrangler": "^4.42.0"
  }
}
