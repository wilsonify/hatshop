<?xml version="1.0" encoding="UTF-8"?>
<!-- Mirrors ../hatshop/phpunit.xml with paths relative to src/, so running
     phpunit from this directory exercises the same suites instead of the
     pre-refactor chapter layout that no longer exists. Result caching is off:
     hatshop/.phpunit.cache/test-results is committed to git, so every run that
     writes it rewrites a tracked file. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
         bootstrap="hatshop/core/vendor/autoload.php"
         colors="true"
         cacheDirectory="hatshop/.phpunit.cache"
         cacheResult="false">
    <testsuites>
        <testsuite name="core-unit">
            <directory>hatshop/core/tests/unit</directory>
        </testsuite>
        <testsuite name="core-integration">
            <directory>hatshop/core/tests/integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">hatshop/core</directory>
        </include>
        <exclude>
            <directory suffix=".php">hatshop/core/vendor</directory>
            <directory suffix=".php">hatshop/core/tests</directory>
            <directory suffix=".php">hatshop/core/Presentation</directory>
        </exclude>
    </source>
</phpunit>
